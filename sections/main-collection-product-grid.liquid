<section>
  <div class="container collection-hero">
    <p class="product-card__eyebrow">SHOP</p>
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="rte">{{ collection.description }}</div>
    {% endif %}
  </div>

  <div class="container">
    {% paginate collection.products by 24 %}
      <div class="product-grid">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p>No products found.</p>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav style="margin-top:48px;display:flex;gap:12px;" aria-label="Pagination">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection product grid",
  "settings": []
}
{% endschema %}
